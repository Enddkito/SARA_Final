<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17"
      fx:controller="com.example.sara_ap.controller.StudentController"
      spacing="15.0"
      style="-fx-background-color: #F8FAFC;"
      prefWidth="700.0" prefHeight="500.0">

    <padding>
        <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
    </padding>

    <VBox spacing="5.0">
        <Label fx:id="lblBienvenidaEstudiante" text="Panel del Estudiante"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
        <Label text="Tu Reporte de Calificaciones Actuales:"
               style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" />
    </VBox>

    <TableView fx:id="tblNotasEstudiante" VBox.vgrow="ALWAYS"
               columnResizePolicy="CONSTRAINED_RESIZE_POLICY"
               style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colMateria" text="Materia / Curso" prefWidth="280.0" />
            <TableColumn fx:id="colNota" text="Nota Obtenida" prefWidth="160.0" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="200.0" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Cerrar Sesión" onAction="#onLogoutClick"
                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                prefWidth="130.0" prefHeight="38.0" />
    </HBox>

</VBox>