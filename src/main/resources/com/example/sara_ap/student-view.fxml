<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.sara_ap.controller.StudentController"
            prefWidth="900.0" prefHeight="650.0" style="-fx-background-color: #f8fafc;">

    <VBox spacing="15.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" style="-fx-padding: 20;">

        <Label text="¡Bienvenido a SARA, Estudiante!" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

        <TabPane fx:id="tabPaneEstudiante" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
                 style="-fx-background-color: white; -fx-border-color: #e2e2e2; -fx-border-radius: 5;">

            <!-- PESTAÑA 1: RESUMEN GENERAL -->
            <Tab text="Resumen General">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="Calificaciones Actuales del Semestre (Escala de 40 Puntos):" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                    <TableView fx:id="tblNotasEstudiante" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMateria" text="Materia / Asignatura" prefWidth="300"/>
                            <TableColumn fx:id="colNota" text="Nota Final (Sobre 40)" prefWidth="150"/>
                            <TableColumn fx:id="colEstado" text="Estado del Curso" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- PESTAÑA 2: DESGLOSE POR MATERIA -->
            <Tab text="Desglose por Materia">
                <VBox spacing="15" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Asignatura Activa:" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="comboMaterias" prefWidth="250" promptText="-- Seleccionar --"/>
                    </HBox>

                    <TableView fx:id="tablaDesglose" VBox.vgrow="ALWAYS"
                               style="-fx-grid-lines-visible: true; -fx-background-color: transparent; -fx-table-cell-border-color: #cbd5e1;">
                        <columns>
                            <TableColumn fx:id="colComponente" text="Aporte Evaluativo" prefWidth="250"/>
                            <TableColumn fx:id="colNotaB1" text="Bimestre 1 (B1)" prefWidth="150"/>
                            <TableColumn fx:id="colNotaB2" text="Bimestre 2 (B2)" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- PESTAÑA 3: ANÁLISIS Y PANEL PREDICTIVO INTEGRADO -->
            <Tab text="Análisis de Rendimiento Semestral">
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                    <VBox spacing="20" style="-fx-padding: 15;">
                        <BarChart fx:id="graficoAportes" prefHeight="220" animated="false">
                            <xAxis><CategoryAxis fx:id="xAxisAportes"/></xAxis>
                            <yAxis><NumberAxis lowerBound="0" upperBound="10" tickUnit="1" autoRanging="false"/></yAxis>
                        </BarChart>
                        <LineChart fx:id="graficoEvolucion" prefHeight="220" animated="false">
                            <xAxis><CategoryAxis fx:id="xAxisEvolucion"/></xAxis>
                            <yAxis><NumberAxis lowerBound="0" upperBound="40" tickUnit="5" autoRanging="false"/></yAxis>
                        </LineChart>

                        <!-- TARJETA DEL ASISTENTE PREDICTIVO INTELIGENTE CON PANEL DE AGENDAMIENTO -->
                        <VBox spacing="15" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                            <Label text="🔮 Asistente Predictivo de Aprobación SARA" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

                            <HBox spacing="20" alignment="CENTER_LEFT">
                                <VBox spacing="3">
                                    <Label text="PUNTOS ACUMULADOS ACTUALES:" style="-fx-font-size: 10; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblAcumuladoPredictivo" text="0.00 / 40.00" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                                </VBox>
                                <VBox spacing="3">
                                    <Label text="REQUERIDO MÍNIMO EN EXAMEN B2:" style="-fx-font-size: 10; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblNotaNecesaria" text="0.00 / 10.00" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                                </VBox>
                            </HBox>

                            <Separator style="-fx-opacity: 0.5;"/>

                            <Label fx:id="lblMensajePredictivo" text="Selecciona una materia..." wrapText="true" style="-fx-font-size: 13;"/>

                            <!-- PANEL INTERACTIVO DE TUTORÍAS (Se despliega automáticamente en Supletorio) -->
                            <VBox fx:id="panelAgendamiento" spacing="12" visible="false" managed="false"
                                  style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6;">
                                <Label text="📅 Panel de Selección de Tutoría de Emergencia" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Fecha disponible:" style="-fx-font-size: 11; -fx-text-fill: #475569;"/>
                                        <DatePicker fx:id="dpFechaTutoria" prefWidth="200.0" promptText="Seleccionar fecha" style="-fx-cursor: hand;"/>
                                    </VBox>
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Horarios del docente:" style="-fx-font-size: 11; -fx-text-fill: #475569;"/>
                                        <ComboBox fx:id="comboHorasTutoria" prefWidth="200.0" promptText="Bloques disponibles" style="-fx-cursor: hand;"/>
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 5 0 0 0;">
                                    <Button fx:id="btnAgendarTutoria" text="Confirmar y Generar Compromiso" onAction="#onAgendarTutoriaClick"
                                            style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 5; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </Tab>

            <Tab text="🔬 Simulador de Notas">
                <content>
                    <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f8fafc;">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <children>
                                    <VBox HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label text="🧮 Laboratorio de Proyecciones Académicas"
                                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                                            <Label text="Modifica libremente las celdas con doble clic para proyectar tus promedios antes de que el docente asiente las notas."
                                                   style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                                        </children>
                                    </VBox>
                                    <ComboBox fx:id="comboSimuladorMaterias" prefWidth="220.0" promptText="Seleccione asignatura..."
                                              style="-fx-background-radius: 5; -fx-border-radius: 5;" />
                                </children>
                            </HBox>

                            <TableView fx:id="tblSimuladorDesglose" editable="true" VBox.vgrow="ALWAYS"
                                       style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6;">
                                <columns>
                                    <TableColumn fx:id="colSimComponente" prefWidth="250.0" text="Aporte Evaluativo (Solo Lectura)" />
                                    <TableColumn fx:id="colSimNotaB1" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Simular B1 (Doble Clic)" />
                                    <TableColumn fx:id="colSimNotaB2" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Simular B2 (Doble Clic)" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>

                            <VBox spacing="10" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 15; -fx-background-radius: 8;">
                                <children>
                                    <Label text="🔮 Veredicto del Escenario Simulado" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                                    <HBox spacing="40">
                                        <children>
                                            <VBox>
                                                <children>
                                                    <Label text="ACUMULADO PROYECTADO:" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
                                                    <Label fx:id="lblSimAcumulado" text="0.00 / 40.00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                                                </children>
                                            </VBox>
                                            <VBox>
                                                <children>
                                                    <Label text="ESTADO HIPOTÉTICO:" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;" />
                                                    <Label fx:id="lblSimMensaje" text="Ingrese valores en la tabla para iniciar la proyección." style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #64748b;" wrapText="true" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <children>
                                    <Button mnemonicParsing="false" onAction="#onResetSimuladorClick"
                                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"
                                            text="🔄 Reestablecer Notas Reales" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </content>
            </Tab>

        </TabPane>

        <!-- BOTÓN INFERIOR DE LOGOUT -->
        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="btnCerrarSesion" text="Cerrar Sesión" onAction="#onLogoutClick"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

</AnchorPane>