<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sara_ap.controller.TeacherController">
    <children>
        <Label fx:id="lblBienvenida" layoutX="49.0" layoutY="38.0" prefHeight="27.0" prefWidth="443.0" text="👨‍🏫 Panel Docente" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <ComboBox fx:id="cmbCursos" layoutX="49.0" layoutY="85.0" onAction="#onCursoSeleccionado" prefWidth="250.0" promptText="Seleccione un curso..." />

        <TabPane layoutX="49.0" layoutY="134.0" prefHeight="350.0" prefWidth="850.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <Tab text="Primer Bimestre">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <TableView fx:id="tblNotasB1" prefHeight="315.0" prefWidth="850.0">
                                    <columns>
                                        <TableColumn fx:id="colIdB1" prefWidth="90.0" text="Cédula" />
                                        <TableColumn fx:id="colNombreB1" prefWidth="180.0" text="Estudiante" />
                                        <TableColumn fx:id="colPVirtualB1" prefWidth="80.0" text="P. Virtual" />
                                        <TableColumn fx:id="colPPresencialB1" prefWidth="90.0" text="P. Presencial" />
                                        <TableColumn fx:id="colExamenB1" prefWidth="80.0" text="Examen" />
                                        <TableColumn fx:id="colTalleresB1" prefWidth="80.0" text="Talleres" />
                                        <TableColumn fx:id="colDeberesB1" prefWidth="80.0" text="Deberes" />
                                        <TableColumn fx:id="colNotaB1" prefWidth="85.0" text="Total B1" />
                                        <TableColumn fx:id="colEstadoB1" prefWidth="85.0" text="Estado" />
                                    </columns>
                                </TableView>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab text="Segundo Bimestre">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <TableView fx:id="tblNotasB2" prefHeight="315.0" prefWidth="850.0">
                                    <columns>
                                        <TableColumn fx:id="colIdB2" prefWidth="90.0" text="Cédula" />
                                        <TableColumn fx:id="colNombreB2" prefWidth="180.0" text="Estudiante" />
                                        <TableColumn fx:id="colPVirtualB2" prefWidth="80.0" text="P. Virtual" />
                                        <TableColumn fx:id="colPPresencialB2" prefWidth="90.0" text="P. Presencial" />
                                        <TableColumn fx:id="colExamenB2" prefWidth="80.0" text="Examen" />
                                        <TableColumn fx:id="colTalleresB2" prefWidth="80.0" text="Talleres" />
                                        <TableColumn fx:id="colDeberesB2" prefWidth="80.0" text="Deberes" />
                                        <TableColumn fx:id="colNotaB2" prefWidth="85.0" text="Total B2" />
                                        <TableColumn fx:id="colEstadoB2" prefWidth="85.0" text="Estado" />
                                    </columns>
                                </TableView>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

            </tabs>
        </TabPane>

        <Label fx:id="lblAlertaDesviacion" layoutX="49.0" layoutY="500.0" prefHeight="40.0" prefWidth="850.0" text="Seleccione un curso para calcular el rendimiento." wrapText="true" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />

        <Button layoutX="779.0" layoutY="560.0" mnemonicParsing="false" onAction="#onLogoutClick" prefHeight="30.0" prefWidth="120.0" text="Cerrar Sesión" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold;" />
    </children>
</AnchorPane>