<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17"
      fx:controller="com.example.sara_ap.controller.HelloController"
      alignment="CENTER"
      spacing="25.0"
      style="-fx-background-color: #F8FAFC;"
      prefWidth="500.0" prefHeight="450.0">

    <padding>
        <Insets top="30.0" right="40.0" bottom="30.0" left="40.0"/>
    </padding>

    <Label text="Iniciar Sesión"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />

    <GridPane vgap="15.0" hgap="10.0" alignment="CENTER" style="-fx-max-width: 350px;">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="90.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Correo:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
        <TextField fx:id="txtEmail" GridPane.rowIndex="0" GridPane.columnIndex="1" prefHeight="35.0" style="-fx-background-radius: 6;" />

        <Label text="Contraseña:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
        <PasswordField fx:id="txtPassword" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="35.0" style="-fx-background-radius: 6;" />
    </GridPane>

    <VBox spacing="10.0" alignment="CENTER" style="-fx-max-width: 350px;" VBox.vgrow="NEVER">
        <Button text="Ingresar al Sistema" onAction="#onAutenticarClick" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                style="-fx-background-color: #1E40AF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />

        <Button text="Volver al Menú" onAction="#onVolverClick" maxWidth="1.7976931348623157E308" prefHeight="35.0"
                style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-weight: bold; -fx-cursor: hand;" />
    </VBox>

</VBox>